import gspreadimport pandas as pdimport sqlalchemyimport uuidimport jsonfrom datetime import datetime, timezonefrom google.oauth2.service_account import Credentialsfrom google.cloud.alloydb.connector import Connector# ==========================================# CONFIGURATION# ==========================================SERVICE_ACCOUNT_FILE = 'credentials.json'SPREADSHEET_URL = 'https://docs.google.com/spreadsheets/d/1rAfiPmCm6VjtcYGDrI82XLWemm7fDgM1g5FMY6cdYDc/edit'WORKSHEET_NAME = 'Belting Upskilling' PROJECT_ID = 'proposal-auto-ai-internal'REGION = 'us-central1' CLUSTER = 'alloydb-epub'INSTANCE = 'alloydb-epub-primary'DB_USER = 'int-user'DB_PASS = '5x;g?3<0_CvNK*Oi'DB_NAME = 'new_db'TABLE_NAME = 'mentorship_plan'INSTANCE_URI = f"projects/{PROJECT_ID}/locations/{REGION}/clusters/{CLUSTER}/instances/{INSTANCE}"# ==========================================# STEP 1: Fetch Data from Google Sheets# ==========================================print("Authenticating with Google Sheets...")scopes = ["https://www.googleapis.com/auth/spreadsheets.readonly", "https://www.googleapis.com/auth/drive.readonly"]creds = Credentials.from_service_account_file(SERVICE_ACCOUNT_FILE, scopes=scopes)client = gspread.authorize(creds)print("Fetching data from Sheet...")sheet = client.open_by_url(SPREADSHEET_URL).worksheet(WORKSHEET_NAME)data = sheet.get_all_records()if not data:    print("The sheet is empty. Exiting.")    exit()df = pd.DataFrame(data)# ==========================================# STEP 2: Connect to AlloyDB# ==========================================print("Connecting to AlloyDB securely...")# Add the Cloud Platform scope so the bot has permission to use the AlloyDB APIalloydb_scopes = ["https://www.googleapis.com/auth/cloud-platform"]alloydb_creds = Credentials.from_service_account_file(SERVICE_ACCOUNT_FILE, scopes=alloydb_scopes)connector = Connector(credentials=alloydb_creds)def getconn():    return connector.connect(        INSTANCE_URI,        "pg8000",        user=DB_USER,        password=DB_PASS,        db=DB_NAME,        enable_iam_auth=False    )pool = sqlalchemy.create_engine("postgresql+pg8000://", creator=getconn)# ==========================================# STEP 3: Build the Name-to-ID Dictionary# ==========================================print("Fetching Employee data to map names to IDs...")with pool.connect() as db_conn:    query = "SELECT techo_id, full_name FROM emp_db"    employee_df = pd.read_sql(query, db_conn)name_to_id_map = dict(zip(employee_df['full_name'], employee_df['techo_id']))# ==========================================# STEP 4: Transform Data to Match Schema# ==========================================print("Transforming data and building JSONB structures...")# 1. Update mapping to exclude the feedback column, we will handle it manuallycolumn_mapping = {    'Mentor Name': 'mentor_techo_id',    'Mentee Name': 'mentee_techo_id',    'Current Belt': 'current_belt',    'Target Belt': 'target_belt',    'Status': 'status',    'Target Completion Date': 'target_completion_date',    'Notes': 'notes',    'Risks / Dependencies': 'risks_dependencies'}# Keep the mapped columns PLUS the two we need to build the JSONcolumns_to_extract = list(column_mapping.keys()) + ['Strengths', 'Improvements']df_mapped = df[columns_to_extract].rename(columns=column_mapping)# Map names to IDsdf_mapped['mentor_techo_id'] = df_mapped['mentor_techo_id'].map(name_to_id_map)df_mapped['mentee_techo_id'] = df_mapped['mentee_techo_id'].map(name_to_id_map)if df_mapped['mentor_techo_id'].isnull().any() or df_mapped['mentee_techo_id'].isnull().any():    print("WARNING: Some employee names in your Google Sheet did not match the names in your AlloyDB.")# Generate timestamps and defaultscurrent_time = datetime.now(timezone.utc)df_mapped['plan_id'] = [str(uuid.uuid4()) for _ in range(len(df_mapped))]df_mapped['is_active'] = Truedf_mapped['created_at'] = current_timedf_mapped['updated_at'] = current_time# Format the timestamp for the JSON object (ISO 8601 format)current_time_iso = current_time.strftime("%Y-%m-%dT%H:%M:%SZ")# 2. Custom function to parse bullets and build the JSON structuredef build_feedback_json(strengths_text, improvements_text, timestamp):    # Parse Strengths    strengths_list = []    if pd.notna(strengths_text) and isinstance(strengths_text, str):        # Split by bullet, remove empty strings and whitespace        strengths_list = [s.strip() for s in strengths_text.split('•') if s.strip()]        # Parse Improvements into focus_areas    focus_areas = []    if pd.notna(improvements_text) and isinstance(improvements_text, str):        improvements_list = [i.strip() for i in improvements_text.split('•') if i.strip()]        for imp in improvements_list:            focus_areas.append({                "id": f"gap_{uuid.uuid4().hex[:6]}", # Generates something like 'gap_88a1b2'                "text": imp,                "status": "OPEN",                "mentee_justification": None, # Turns into 'null' in JSON                "submitted_at": timestamp,                "resolved_at": None            })                # Return as a stringified JSON object ready for the database    return json.dumps({        "strengths": strengths_list,        "focus_areas": focus_areas    })# 3. Apply the function row-by-row to create the 'feedback_data' columndf_mapped['feedback_data'] = df_mapped.apply(    lambda row: build_feedback_json(row['Strengths'], row['Improvements'], current_time_iso),     axis=1)# 4. Drop the original Google Sheet columns so they don't break the SQL insertdf_mapped = df_mapped.drop(columns=['Strengths', 'Improvements'])# ==========================================# STEP 5: Insert Data into AlloyDB# ==========================================print(f"Inserting mapped data into '{TABLE_NAME}'...")with pool.connect() as db_conn:    df_mapped.to_sql(TABLE_NAME, db_conn, if_exists='append', index=False, method='multi')print("Migration completed successfully!")connector.close()
